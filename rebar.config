{erl_opts, [debug_info]}.
{deps, [{opentelemetry, "~> 1.5"}]}.
%% changing base_dir to avoid collisions with mix
{base_dir, "_build.rebar"}.

{profiles,
 [{test,
   [{extra_src_dirs, ["test/helpers"]},
    {deps,
     [{test_logs, {git, "https://github.com/ErlGang/test_logs.git", {branch, "main"}}},
      {proper, "~> 1.4"}]}]}]}.

{project_plugins,
 [{rebar3_ex_doc, "~> 0.2"},
  rebar3_efmt]}.

{ex_doc,
 [{extras, ["README.md"]},
  {main, "README.md"},
  {source_url, "https://github.com/ErlGang/opentelemetry_testing"}]}.
